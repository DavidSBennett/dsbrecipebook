{
  "manifest_version": 3,
  "name": "DSB Recipe Book → Kroger",
  "version": "1.0.0",
  "description": "Send your DSB Recipe Book grocery list to kroger.com and add the items to your cart.",
  "key": "",
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://api.kroger.com/*",
    "https://api-ce.kroger.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "DSB Recipe Book → Kroger" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://recipes.davidsbennett.com/*",
        "http://127.0.0.1:8173/*",
        "http://localhost:8173/*"
      ],
      "js": ["site-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.kroger.com/*"],
      "js": ["matching.js", "kroger-panel.js"],
      "run_at": "document_idle"
    }
  ]
}
