# recipes.davidsbennett.com (GreenGeeks): always use HTTPS, and drop "www.".
# The GitHub token is typed into this site, so it must never load over plain http.
# /.well-known/ is left alone so cPanel AutoSSL can renew the certificate.
RewriteEngine On

RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# The server's default is to let browsers keep .js/.css for ~15 days, which would hide every
# update. "no-cache" makes the browser check for a newer copy each visit (a quick 304 if unchanged).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
